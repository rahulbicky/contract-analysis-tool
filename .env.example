# Groq (chat / reasoning) — get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings run locally via sentence-transformers (no API key or cost).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Drop reranked chunks scoring below this cross-encoder threshold to raise
# context precision (fewer irrelevant chunks). Leave empty to disable.
RERANK_SCORE_THRESHOLD=0.0

# Qdrant vector database
# Local/self-hosted (e.g. docker-compose):
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Qdrant Cloud instead (leave QDRANT_HOST/PORT unset if using this):
# QDRANT_URL=https://xxxxxxxx.qdrant.io
# QDRANT_API_KEY=

# LangSmith observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ContractLens API
# Required — the API refuses all requests to protected endpoints until this is set.
CONTRACTLENS_API_KEY=
# Comma-separated list of origins allowed to call the API (CORS).
CONTRACTLENS_ALLOWED_ORIGINS=http://localhost:8501
# Max PDF upload size, in megabytes.
CONTRACTLENS_MAX_UPLOAD_MB=20

# Streamlit UI — must match the API's CONTRACTLENS_API_KEY above and point at
# wherever the API is reachable (e.g. http://api:8000 in docker-compose).
CONTRACTLENS_API_URL=http://localhost:8000
